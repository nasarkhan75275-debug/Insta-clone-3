* { margin: 0; padding: 0; box-sizing: border-box; font-family: sans-serif; }
body { background: #fafafa; padding-bottom: 60px; }
.navbar { background: #fff; border-bottom: 1px solid #dbdbdb; padding: 12px 15px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 10; }
.logo { font-family: 'Segoe UI', sans-serif; font-weight: 800; letter-spacing: 2px; background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
.nav-icons i { margin-left: 15px; font-size: 20px; }
.container { max-width: 500px; margin: auto; }
.stories { background: #fff; border: 1px solid #dbdbdb; display: flex; gap: 15px; padding: 15px; overflow-x: auto; margin-bottom: 10px; }
.story { text-align: center; font-size: 12px; }
.story-img { width: 60px; height: 60px; border-radius: 50%; padding: 2px; background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #bc1888); }
.story-img img { width: 100%; height: 100%; border-radius: 50%; border: 2px solid #fff; }
.post { background: #fff; border: 1px solid #dbdbdb; margin-bottom: 10px; }
.post-header { display: flex; align-items: center; padding: 10px; gap: 10px; }
.post-header img { width: 32px; height: 32px; border-radius: 50%; }
.post-header i { margin-left: auto; }
.post-img { width: 100%; height: auto; }
.post-actions { padding: 10px; display: flex; gap: 15px; font-size: 22px; }
.bookmark { margin-left: auto; }
.caption { padding: 0 10px 15px; font-size: 14px; }
.bottom-nav { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; border-top: 1px solid #dbdbdb; display: flex; justify-content: space-around; padding: 12px 0; font-size: 22px; }
.liked { color: red; font-weight: 900; }
